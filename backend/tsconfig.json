{
  // Used by the editor and by `npm run typecheck`. Covers everything that is
  // TypeScript in the backend, tests included: vitest runs tests without
  // type-checking them, so this is the only place their types get verified.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "prisma/seed.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
