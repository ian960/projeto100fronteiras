# Copy to .env and fill in. Only DATABASE_URL is required to run locally.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Same user/password/database as the root .env used by docker compose.
# The port is POSTGRES_PORT from the root .env (5433 unless you changed it).
# Used only when the API runs outside Docker: in Docker, docker-compose.yml
# sets the address itself (and PORT too).
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5433/portal100fronteiras?schema=public"

# ---------------------------------------------------------------------------
# Optional in development (safe defaults are used when empty)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3333

# Front-end origin, used by CORS. Default: http://localhost:5173
SITE_URL=http://localhost:5173

# Production only (Render generates it): the secret shared with the Cloudflare
# Worker that serves the site. With it set, requests that do not come through
# the Worker are refused. Leave empty in development.
PROXY_SECRET=

# Required in production. In development a fixed fallback is used and a
# warning is logged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary — images, videos and PDFs. Optional in development: left empty,
# the API works, /api/media/* answers 503 and news cannot be published (a
# cover is required). Required in production.
#
# Cloudinary console → Settings → API Keys → "API environment variable".
# Also turn on Settings → Security → "Allow delivery of PDF and ZIP files".
# ---------------------------------------------------------------------------
CLOUDINARY_URL=

# Top folder for this environment's files. Use different ones if development
# and production share one Cloudinary account. Default: portal
CLOUDINARY_FOLDER=portal-dev

# ---------------------------------------------------------------------------
# E-mail (password recovery)
# log (default): nothing is sent; the message and its link go to the API log.
# brevo: needs MAIL_API_KEY (Brevo > SMTP & API > API keys) and MAIL_FROM,
#        a sender address verified in Brevo (a Gmail works).
# resend: same two variables; needs a domain verified in Resend.
# ---------------------------------------------------------------------------
MAIL_PROVIDER=log
# (docker compose already uses mailpit: inbox at http://localhost:8025)
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Portal100Fronteiras
# Where the contact form (/contato) delivers. Empty: MAIL_FROM.
CONTACT_EMAIL=
# Newsletter e-mails per 24 hours. Brevo's free plan sends 300 a day in all;
# 250 leaves room for password links and the contact form. Empty: 250.
NEWSLETTER_DAILY_LIMIT=

# Push notifications ("Ativar notificações" on the site). Make the pair once:
#   npx web-push generate-vapid-keys
# and paste both. The private key is a secret: only here and on Render.
# Leave both empty to hide the button. VAPID_SUBJECT: mailto: or https:
# address the push services can contact; empty = mailto:CONTACT_EMAIL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Notifications the admin can send in 24 hours. Empty: 5.
PUSH_DAILY_LIMIT=

# "Entrar com Google". From the OAuth client in the Google Cloud Console
# (APIs & Services > Credentials). Leave both empty to hide the button.
# Google sends readers back to SITE_URL + /api/auth/google/callback, so
# http://localhost:5173/api/auth/google/callback must be one of the client's
# "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# First admin, created by `npm run db:seed`
# Defaults in development: admin@portal.local / admin12345
# In production SEED_ADMIN_PASSWORD is mandatory.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
