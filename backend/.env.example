# Copy to .env and fill in. Only DATABASE_URL is required to run locally.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Same user/password/database as the root .env used by docker compose.
# The port is POSTGRES_PORT from the root .env (5433 unless you changed it).
# Used only when the API runs outside Docker: in Docker, docker-compose.yml
# sets the address itself (and PORT too).
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5433/portal100fronteiras?schema=public"

# ---------------------------------------------------------------------------
# Optional in development (safe defaults are used when empty)
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3333

# Front-end origin, used by CORS. Default: http://localhost:5173
SITE_URL=http://localhost:5173

# Required in production. In development a fixed fallback is used and a
# warning is logged. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary — images, videos and PDFs. Optional in development: left empty,
# the API works, /api/media/* answers 503 and news cannot be published (a
# cover is required). Required in production.
#
# Cloudinary console → Settings → API Keys → "API environment variable".
# Also turn on Settings → Security → "Allow delivery of PDF and ZIP files".
# ---------------------------------------------------------------------------
CLOUDINARY_URL=

# Top folder for this environment's files. Use different ones if development
# and production share one Cloudinary account. Default: portal
CLOUDINARY_FOLDER=portal-dev

# ---------------------------------------------------------------------------
# First admin, created by `npm run db:seed`
# Defaults in development: admin@portal.local / admin12345
# In production SEED_ADMIN_PASSWORD is mandatory.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
