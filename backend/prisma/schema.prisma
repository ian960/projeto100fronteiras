

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role { 
  admin
  columnist
  reader
}

enum AuthorType {
  writer
  columnist
}

enum PostType {
  news
  column
}

enum PostStatus {
  draft
  pending
  published
}



model User {
  id String @id @default(uuid(7))
  name String
  email String @unique
  passwordHash String @map("password_hash")
  
  role Role @default(reader)

  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author Author?

  createdPosts   Post[] @relation("PostCreatedBy")
  publishedPosts Post[] @relation("PostPublishedBy")

  @@map("users")

}

model Author {
  id String @id @default(uuid(7))
  name String
  slug String @unique
  photoUrl String? @map("photo_url")
  bio String?
  columnTitle String? @map("column_title")
  type AuthorType
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @unique @map("user_id")
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  posts Post[]

  @@index([type, active])
  @@map("authors")
}

model Category {
  id String @id @default(uuid(7))
  name String @unique
  slug String @unique
  active Boolean @default(true)
  sortOrder Int @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map ("categories")

}

model Post {
  id String @id @default(uuid(7))
  type PostType
  status PostStatus @default(draft)

  title String
  subtitle String?
  slug String @unique

  excerpt String @default("")
  content String @default("")
  coverUrl String? @map("conver_url")
  coverAlt String? @map("conver_alt")

  featured Boolean @default(false)

  publishedAt DateTime? @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId String? @map("category_id")
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  authorId String @map("author_id")
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Who actually typed it (audit trail — the admin may write on a writer's behalf).
  createdById String @map("created_by_id")
  createdBy   User   @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Who hit publish. Always an admin.
  publishedById String? @map("published_by_id")
  publishedBy   User?   @relation("PostPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  // --- video: uncomment only after the client picks an option ---
  // videoUrl      String? @map("video_url")
  // videoProvider String? @map("video_provider") // "youtube" | "r2" | "stream"

  // Home feed and columnists tab.
  @@index([type, status, publishedAt(sort: Desc)])
  // Category page.
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // Author page and "my columns" in the panel.
  @@index([authorId, status, publishedAt(sort: Desc)])
  @@map("posts")

}

model Session {
  sid String @id @db.VarChar
  sess Json @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}