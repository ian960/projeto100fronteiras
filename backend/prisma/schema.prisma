// Portal Sem Fronteiras — Prisma schema
//
// Convention: models and fields in English (camelCase), database columns in
// snake_case via @map. Keeps raw SQL readable when someone opens psql.
//
// Prisma 7: the datasource block has NO url. Connection strings live in
// prisma.config.ts (for the CLI) and in the driver adapter (for the runtime).
//
// Keep the `generator` block that your own `prisma init` produced — the
// output path decides where you import PrismaClient from.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The backend is a CommonJS package ("type": "commonjs"). Left to infer,
  // Prisma emits `import.meta.url`, which tsx tolerates in development but
  // crashes `node dist/server.js` after `npm run build`.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  columnist
  reader // everyone signs up as this; the admin promotes to columnist
}

enum AuthorType {
  writer // byline only, no login — the admin picks it when publishing news
  columnist // has a login and writes their own columns
}

enum PostType {
  news
  column
}

enum PostStatus {
  draft // being written
  pending // columnist submitted, waiting for the admin
  published // live
}

// Where an advertiser's banner shows on the site. Each value is one place in
// the layout (frontend/src/site/BannerSlot.tsx); a place with no banner
// running draws nothing at all.
enum BannerSlot {
  home_top // home page, above the carousel
  home_middle // home page, between the latest news and the category blocks
  article_middle // inside the text of a story or column, halfway through
  article_end // after the text of a story or column
  site_footer // every page of the site, just above the footer
}

enum MediaKind {
  image // covers, photos inside the text, author photos
  video
  document // PDF only
}

// ---------------------------------------------------------------------------
// User — anyone who can log in
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid(7))

  // Account holder's name. Distinct from Author.name, which is the byline —
  // a columnist may sign under a different name than the one on their account.
  name String

  email        String  @unique
  // Null for someone who only ever signed in with Google. They can set one
  // later on "Minha conta" or through "Esqueci minha senha".
  passwordHash String? @map("password_hash")
  // The Google account ("sub" of its ID token) linked to this one, if any.
  // Set on the first "Entrar com Google", by a verified e-mail match.
  googleId     String? @unique @map("google_id")

  // Self sign-up always lands here. Only an admin can change it.
  // NEVER read this field from request input — see the register schema.
  role Role @default(reader)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The account's own profile, edited by its owner on "Minha conta".
  // Different from the byline (Author): every user has these, readers too.
  bio      String?
  avatarId String? @map("avatar_id")
  // SetNull: if the admin ever deletes the file, the account just loses its photo.
  avatar   Media?  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  // Created when the admin promotes a reader to columnist.
  // Readers and the admin have none.
  author Author?

  createdPosts   Post[]  @relation("PostCreatedBy")
  comments       Comment[] @relation("CommentAuthor")
  resetTokens    PasswordResetToken[]
  publishedPosts Post[]  @relation("PostPublishedBy")
  uploadedMedia  Media[] @relation("MediaUploadedBy")
  newsletterIssues NewsletterIssue[]
  pushNotifications PushNotification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Author — writer (byline only) or columnist (byline + login)
// ---------------------------------------------------------------------------

model Author {
  id          String     @id @default(uuid(7))
  name        String
  slug        String     @unique
  bio         String?
  columnTitle String?    @map("column_title") // columnists only
  type        AuthorType
  active      Boolean    @default(true)
  // Position on /colunistas and in the panel list, set by the admin (0 first).
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Null for writers, set for columnists.
  // SetNull: deleting the login keeps the profile and the published posts —
  // the author page stays online, they just lose access.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Shown next to the byline and on the author page.
  photoId String? @map("photo_id")
  photo   Media?  @relation("AuthorPhoto", fields: [photoId], references: [id], onDelete: Restrict)

  posts Post[]

  @@index([type, active])
  @@map("authors")
}

// ---------------------------------------------------------------------------
// Category — news only
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order") // position in the site menu
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts       Post[]
  newsSources NewsSource[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Post — news and columns share one table, split by `type`
// ---------------------------------------------------------------------------

model Post {
  id     String     @id @default(uuid(7))
  type   PostType
  status PostStatus @default(draft)

  title    String
  subtitle String?
  slug     String  @unique

  // content and cover start empty on purpose: a draft is allowed to be
  // incomplete. Completeness is enforced by the service on publish, not here.
  // The excerpt (summary) is optional even to publish: "" means none.
  excerpt String @default("")
  content String @default("") // HTML, already sanitized server-side

  // Credit for a story taken from another outlet ("Fonte: G1", with a link).
  // Both optional; the URL may be absent when the source is not online.
  sourceName String? @map("source_name")
  sourceUrl  String? @map("source_url")

  // Required to publish news (checked by the service, not here: a draft may
  // be saved without one). The alt text belongs to the post, not to the file:
  // the same photo can illustrate two stories and deserve two descriptions.
  coverId  String? @map("cover_id")
  cover    Media?  @relation("PostCover", fields: [coverId], references: [id], onDelete: Restrict)
  coverAlt String? @map("cover_alt")

  // In the home page carousel, chosen by the admin. Any number of posts; the
  // most recently featured comes first. Fewer than four are topped up with
  // the latest news (see getHome).
  featured   Boolean   @default(false)
  featuredAt DateTime? @map("featured_at")

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // News always has a category. A column never does.
  // Enforced by the CHECK constraint added in the migration.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Whose name signs the piece. News may instead be signed with a free-text
  // name (bylineName, not a registered author) or by nobody (both null).
  // A column always has an author. Enforced by the CHECK constraints
  // "posts_single_byline" and "posts_column_has_author" in the migration.
  authorId   String? @map("author_id")
  author     Author? @relation(fields: [authorId], references: [id], onDelete: Restrict)
  bylineName String? @map("byline_name")

  // Who actually typed it (audit trail — the admin may write on a writer's behalf).
  createdById String @map("created_by_id")
  createdBy   User   @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Who hit publish. Always an admin.
  publishedById String? @map("published_by_id")
  publishedBy   User?   @relation("PostPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  // Video: a YouTube link or a file uploaded to Cloudinary, never both.
  // Enforced by the CHECK constraint "posts_single_video" in the migration.
  videoYoutubeId String? @map("video_youtube_id") // the 11-char id, not the URL
  videoId        String? @map("video_id")
  video          Media?  @relation("PostVideo", fields: [videoId], references: [id], onDelete: Restrict)

  // PDFs listed under the text ("Documentos desta matéria").
  attachments PostAttachment[]

  comments Comment[]
  pushNotifications PushNotification[]

  // Set when the post was brought in by the news import (see NewsSource).
  importedFrom ImportedItem?

  // Home feed and columnists tab.
  @@index([type, status, publishedAt(sort: Desc)])
  // Category page.
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // Author page and "my columns" in the panel.
  @@index([authorId, status, publishedAt(sort: Desc)])
  // Home carousel.
  @@index([featured, featuredAt(sort: Desc)])
  // Latest of any kind: the "Leia também" fill and /api/posts without a type.
  @@index([status, publishedAt(sort: Desc)])
  @@map("posts")
}

// ---------------------------------------------------------------------------
// Media — every file uploaded to Cloudinary
//
// The bytes live in Cloudinary; this table is the index. Knowing who uploaded
// what, and what uses it, is what makes it possible to delete safely and to
// find files nobody uses anymore.
//
// Delivery URLs are never stored: they are built from publicId + version +
// format (see media.urls.ts), so changing a size or a format later is a code
// change, not a data migration.
// ---------------------------------------------------------------------------

model Media {
  id   String    @id @default(uuid(7))
  kind MediaKind

  // Cloudinary public_id with its folder, e.g. "portal/covers/<uuid>".
  // Chosen by the server when it signs the upload; the browser cannot pick it.
  publicId String @unique @map("public_id")

  // Cloudinary version (an upload timestamp). Part of every delivery URL.
  // Text, not Int: the number stops fitting a 32-bit column in 2038.
  version String

  format       String // jpg, png, webp, heic, mp4, mov, pdf…
  bytes        Int
  width        Int?
  height       Int?
  durationSec  Float? @map("duration_sec") // video
  pages        Int? // PDF
  originalName String @map("original_name")

  createdAt DateTime @default(now()) @map("created_at")

  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  coverOf    Post[]           @relation("PostCover")
  videoOf    Post[]           @relation("PostVideo")
  photoOf    Author[]         @relation("AuthorPhoto")
  avatarOf   User[]           @relation("UserAvatar")
  bannerOf   Banner[]         @relation("BannerImage")
  bannerMobileOf Banner[]     @relation("BannerMobileImage")
  attachedTo PostAttachment[]

  // "My uploads", newest first.
  @@index([uploadedById, createdAt(sort: Desc)])
  @@map("media")
}

// A PDF attached to a post. Deleting the post deletes these rows (Cascade):
// they are part of the post. The file itself is kept (Restrict on media) and
// can be removed separately once nothing uses it.
model PostAttachment {
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  title    String // what the reader sees: "Edital completo", not "scan_0034.pdf"
  position Int

  @@id([postId, mediaId])
  @@index([mediaId])
  @@map("post_attachments")
}

// ---------------------------------------------------------------------------
// Session — connect-pg-simple's table
//
// Declared here only so Prisma knows it exists. You will NEVER call
// `prisma.session` in application code — express-session owns this table.
//
// Left out of the schema, `prisma migrate dev` would report drift and offer to
// reset the database, taking your development data with it.
//
// Configure the store with `createTableIfMissing: false`, since Prisma creates it.
// The table name must stay exactly "session".
// ---------------------------------------------------------------------------

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Readers' comments under a news story or a column. Plain text only.
model Comment {
  id String @id @default(uuid(7))

  // Deleting the post takes its comments with it.
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Null once the account is deleted: the text stays, signed "Conta excluída".
  userId String? @map("user_id")
  user   User?   @relation("CommentAuthor", fields: [userId], references: [id], onDelete: SetNull)

  // One level of replies: a reply always hangs from a top-level comment
  // (the service attaches a reply to a reply to the same top-level comment).
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  content String // plain text, never HTML

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at") // shown as "editado em…"
  // A comment with replies is not removed, only emptied, so the replies keep
  // their context. Without replies it is really deleted.
  deletedAt DateTime? @map("deleted_at")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@map("comments")
}

// "Esqueci minha senha": one row per link sent by e-mail.
model PasswordResetToken {
  id String @id @default(uuid(7))

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 of the token in the link, never the token itself: someone who
  // reads the database still cannot reset anybody's password.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") // one hour after it was sent
  usedAt    DateTime? @map("used_at") // single use
  createdAt DateTime  @default(now()) @map("created_at")

  // "How many links did this account get in the last hour?"
  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Banner — a local advertiser's ad, managed by the admin
//
// Shown only between startsAt and endsAt, and only while active. A slot with
// nothing running is not drawn at all: the site looks exactly as without ads.
// ---------------------------------------------------------------------------

model Banner {
  id String @id @default(uuid(7))

  // Both optional: a banner can be just a picture.
  advertiser String? // who pays, e.g. "Padaria Central". Shown in the panel and as the image's alt text.
  linkUrl    String? @map("link_url") // where a click goes (http/https only). Without it, not clickable.
  slot       BannerSlot

  // Restrict: a file in use by a banner cannot be deleted from under it.
  imageId String @map("image_id")
  image   Media  @relation("BannerImage", fields: [imageId], references: [id], onDelete: Restrict)

  // Optional narrower picture for phones. Without it, phones get `image`.
  mobileImageId String? @map("mobile_image_id")
  mobileImage   Media?  @relation("BannerMobileImage", fields: [mobileImageId], references: [id], onDelete: Restrict)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")
  active   Boolean  @default(true) // the admin's on/off switch, independent of the dates

  // The monthly report for the advertiser.
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // "What is running in this slot right now?"
  @@index([slot, active, startsAt, endsAt])
  @@index([imageId])
  @@index([mobileImageId])
  @@map("banners")
}

// ---------------------------------------------------------------------------
// Newsletter — opt-in only, sent by the admin from the panel
//
// A subscriber is an e-mail address, with or without an account (the account
// page finds its row by the account's e-mail). Nobody is ever subscribed
// without asking: the site form and an account without a verified e-mail go
// through a confirmation link first (double opt-in).
// ---------------------------------------------------------------------------

enum NewsletterStatus {
  pending // asked, has not clicked the confirmation link yet
  active // receives the newsletter
  unsubscribed // left; kept so nothing is ever sent again without a new opt-in
}

enum NewsletterDeliveryStatus {
  pending // waiting for its turn (the daily limit, see newsletter.service.ts)
  sent
  failed // three attempts and the mail service refused it
  cancelled // the admin stopped the send, or the reader left before their turn
}

model NewsletterSubscriber {
  id String @id @default(uuid(7))

  email  String           @unique // lowercase
  status NewsletterStatus @default(pending)
  // Where the request came from: "site" (the form), "conta" (Minha conta),
  // "cadastro" (the sign-up box).
  source String

  // In every e-mail's "Descadastrar" link. Stored as is (it has to go into
  // each e-mail); all it can do is unsubscribe this one address.
  unsubscribeToken String @unique @map("unsubscribe_token")

  // The confirmation link: SHA-256 of the token, like the password links.
  confirmTokenHash String?   @unique @map("confirm_token_hash")
  confirmSentAt    DateTime? @map("confirm_sent_at")

  confirmedAt    DateTime? @map("confirmed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  deliveries NewsletterDelivery[]

  @@index([status])
  @@map("newsletter_subscribers")
}

// One newsletter the admin sent: the e-mail is built once, when it is created,
// so editing a story afterwards does not change what is still waiting to go.
model NewsletterIssue {
  id      String  @id @default(uuid(7))
  subject String
  intro   String?
  // Ready to send, with UNSUBSCRIBE_PLACEHOLDER where each reader's own link goes.
  html    String
  text    String

  // SetNull: deleting the admin's account keeps the history.
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  deliveries NewsletterDelivery[]

  @@index([createdAt(sort: Desc)])
  @@map("newsletter_issues")
}

// One e-mail of one issue to one subscriber. The queue: whatever is pending
// goes out as the daily limit allows, oldest issue first.
model NewsletterDelivery {
  id String @id @default(uuid(7))

  issueId String          @map("issue_id")
  issue   NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  subscriberId String               @map("subscriber_id")
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  status    NewsletterDeliveryStatus @default(pending)
  attempts  Int                      @default(0)
  sentAt    DateTime?                @map("sent_at")
  createdAt DateTime                 @default(now()) @map("created_at")

  @@unique([issueId, subscriberId])
  // The queue, in order.
  @@index([status, createdAt])
  // "How many went out in the last 24 hours?"
  @@index([sentAt])
  @@map("newsletter_deliveries")
}

// ── Push notifications (modules/push) ─────────────────────────────────────────

// One browser that asked for notifications, by clicking "Ativar
// notificações". Not tied to an account: the endpoint is an address at the
// browser's push service (Google, Mozilla, Apple, Microsoft), and the keys
// encrypt the message so that only that browser can read it. Nothing else
// about the reader is stored.
model PushSubscription {
  id       String @id @default(uuid(7))
  endpoint String @unique
  p256dh   String
  auth     String

  // Refusals in a row that were not "gone" (404/410, deleted at once). After
  // a few, the subscription is dropped too.
  failures   Int       @default(0)
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("push_subscriptions")
}

enum PushNotificationStatus {
  sending
  done
}

// One notification the admin sent, about one story. It goes out in batches
// (cursor = the last subscription reached), so a restart of the server
// picks it up where it stopped.
model PushNotification {
  id    String  @id @default(uuid(7))
  title String
  body  String
  url   String
  image String?

  // SetNull: deleting the story keeps the history.
  postId String? @map("post_id")
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  status  PushNotificationStatus @default(sending)
  cursor  String?
  total   Int                    @default(0)
  sent    Int                    @default(0)
  failed  Int                    @default(0)
  removed Int                    @default(0)

  createdById String?   @map("created_by_id")
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")
  finishedAt  DateTime? @map("finished_at")

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@map("push_notifications")
}

// ---------------------------------------------------------------------------
// News import — RSS feeds of other outlets, turned into drafts
//
// Every few minutes the server reads each active source's feed
// (modules/newsImport). Each new item becomes a DRAFT news post with
// "Fonte: <name>" and the link; the admin reviews, adds a cover and publishes.
// Nothing is ever published on its own.
//
// fullText decides how much is copied. Only sources whose license allows
// republishing (Agência Brasil, Agência Senado, gov.br…) may have the whole
// text; for any other the draft holds the summary and a link to the original.
// ---------------------------------------------------------------------------

model NewsSource {
  id       String  @id @default(uuid(7))
  name     String // shown as "Fonte: <name>" under the story
  feedUrl  String  @unique @map("feed_url")
  fullText Boolean @default(false) @map("full_text")
  active   Boolean @default(true)

  // Category the drafts go into. Null only after that category was deleted:
  // the source then waits until the admin picks another.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // The last time the feed was read, and how it went.
  lastRunAt         DateTime? @map("last_run_at")
  lastError         String?   @map("last_error")
  lastImportedCount Int       @default(0) @map("last_imported_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ImportedItem[]

  @@map("news_sources")
}

// One row per feed item already seen, so nothing is imported twice, not even
// after the admin deletes the draft (postId becomes null, the row stays).
model ImportedItem {
  id       String     @id @default(uuid(7))
  sourceId String     @map("source_id")
  source   NewsSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // The item's <guid>, or its link when the feed has none.
  guid String

  postId String? @unique @map("post_id")
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  // The item's photo on the source's site. Not copied to Cloudinary until the
  // admin chooses it as the cover in the editor.
  imageUrl String? @map("image_url")

  importedAt DateTime @default(now()) @map("imported_at")

  @@unique([sourceId, guid])
  @@index([importedAt(sort: Desc)])
  @@map("imported_items")
}
