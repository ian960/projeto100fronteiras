// Portal Sem Fronteiras — Prisma schema
//
// Convention: models and fields in English (camelCase), database columns in
// snake_case via @map. Keeps raw SQL readable when someone opens psql.
//
// Prisma 7: the datasource block has NO url. Connection strings live in
// prisma.config.ts (for the CLI) and in the driver adapter (for the runtime).
//
// Keep the `generator` block that your own `prisma init` produced — the
// output path decides where you import PrismaClient from.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The backend is a CommonJS package ("type": "commonjs"). Left to infer,
  // Prisma emits `import.meta.url`, which tsx tolerates in development but
  // crashes `node dist/server.js` after `npm run build`.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  admin
  columnist
  reader // everyone signs up as this; the admin promotes to columnist
}

enum AuthorType {
  writer // byline only, no login — the admin picks it when publishing news
  columnist // has a login and writes their own columns
}

enum PostType {
  news
  column
}

enum PostStatus {
  draft // being written
  pending // columnist submitted, waiting for the admin
  published // live
}

enum MediaKind {
  image // covers, photos inside the text, author photos
  video
  document // PDF only
}

// ---------------------------------------------------------------------------
// User — anyone who can log in
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid(7))

  // Account holder's name. Distinct from Author.name, which is the byline —
  // a columnist may sign under a different name than the one on their account.
  name String

  email        String @unique
  passwordHash String @map("password_hash")

  // Self sign-up always lands here. Only an admin can change it.
  // NEVER read this field from request input — see the register schema.
  role Role @default(reader)

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The account's own profile, edited by its owner on "Minha conta".
  // Different from the byline (Author): every user has these, readers too.
  bio      String?
  avatarId String? @map("avatar_id")
  // SetNull: if the admin ever deletes the file, the account just loses its photo.
  avatar   Media?  @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)

  // Created when the admin promotes a reader to columnist.
  // Readers and the admin have none.
  author Author?

  createdPosts   Post[]  @relation("PostCreatedBy")
  comments       Comment[] @relation("CommentAuthor")
  publishedPosts Post[]  @relation("PostPublishedBy")
  uploadedMedia  Media[] @relation("MediaUploadedBy")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Author — writer (byline only) or columnist (byline + login)
// ---------------------------------------------------------------------------

model Author {
  id          String     @id @default(uuid(7))
  name        String
  slug        String     @unique
  bio         String?
  columnTitle String?    @map("column_title") // columnists only
  type        AuthorType
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Null for writers, set for columnists.
  // SetNull: deleting the login keeps the profile and the published posts —
  // the author page stays online, they just lose access.
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Shown next to the byline and on the author page.
  photoId String? @map("photo_id")
  photo   Media?  @relation("AuthorPhoto", fields: [photoId], references: [id], onDelete: Restrict)

  posts Post[]

  @@index([type, active])
  @@map("authors")
}

// ---------------------------------------------------------------------------
// Category — news only
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid(7))
  name      String   @unique
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order") // position in the site menu
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Post — news and columns share one table, split by `type`
// ---------------------------------------------------------------------------

model Post {
  id     String     @id @default(uuid(7))
  type   PostType
  status PostStatus @default(draft)

  title    String
  subtitle String?
  slug     String  @unique

  // excerpt, content and cover start empty on purpose: a draft is allowed to
  // be incomplete. Completeness is enforced by the service on publish, not here.
  excerpt String @default("")
  content String @default("") // HTML, already sanitized server-side

  // Required to publish news (checked by the service, not here: a draft may
  // be saved without one). The alt text belongs to the post, not to the file:
  // the same photo can illustrate two stories and deserve two descriptions.
  coverId  String? @map("cover_id")
  cover    Media?  @relation("PostCover", fields: [coverId], references: [id], onDelete: Restrict)
  coverAlt String? @map("cover_alt")

  // Lead story on the home page. Only one at a time — enforced by a partial
  // unique index added in the migration (Prisma cannot express it here).
  featured Boolean @default(false)

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // News always has a category. A column never does.
  // Enforced by the CHECK constraint added in the migration.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Whose name signs the piece.
  authorId String @map("author_id")
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Who actually typed it (audit trail — the admin may write on a writer's behalf).
  createdById String @map("created_by_id")
  createdBy   User   @relation("PostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  // Who hit publish. Always an admin.
  publishedById String? @map("published_by_id")
  publishedBy   User?   @relation("PostPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  // Video: a YouTube link or a file uploaded to Cloudinary, never both.
  // Enforced by the CHECK constraint "posts_single_video" in the migration.
  videoYoutubeId String? @map("video_youtube_id") // the 11-char id, not the URL
  videoId        String? @map("video_id")
  video          Media?  @relation("PostVideo", fields: [videoId], references: [id], onDelete: Restrict)

  // PDFs listed under the text ("Documentos desta matéria").
  attachments PostAttachment[]

  comments Comment[]

  // Home feed and columnists tab.
  @@index([type, status, publishedAt(sort: Desc)])
  // Category page.
  @@index([categoryId, status, publishedAt(sort: Desc)])
  // Author page and "my columns" in the panel.
  @@index([authorId, status, publishedAt(sort: Desc)])
  @@map("posts")
}

// ---------------------------------------------------------------------------
// Media — every file uploaded to Cloudinary
//
// The bytes live in Cloudinary; this table is the index. Knowing who uploaded
// what, and what uses it, is what makes it possible to delete safely and to
// find files nobody uses anymore.
//
// Delivery URLs are never stored: they are built from publicId + version +
// format (see media.urls.ts), so changing a size or a format later is a code
// change, not a data migration.
// ---------------------------------------------------------------------------

model Media {
  id   String    @id @default(uuid(7))
  kind MediaKind

  // Cloudinary public_id with its folder, e.g. "portal/covers/<uuid>".
  // Chosen by the server when it signs the upload; the browser cannot pick it.
  publicId String @unique @map("public_id")

  // Cloudinary version (an upload timestamp). Part of every delivery URL.
  // Text, not Int: the number stops fitting a 32-bit column in 2038.
  version String

  format       String // jpg, png, webp, heic, mp4, mov, pdf…
  bytes        Int
  width        Int?
  height       Int?
  durationSec  Float? @map("duration_sec") // video
  pages        Int? // PDF
  originalName String @map("original_name")

  createdAt DateTime @default(now()) @map("created_at")

  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  coverOf    Post[]           @relation("PostCover")
  videoOf    Post[]           @relation("PostVideo")
  photoOf    Author[]         @relation("AuthorPhoto")
  avatarOf   User[]           @relation("UserAvatar")
  attachedTo PostAttachment[]

  // "My uploads", newest first.
  @@index([uploadedById, createdAt(sort: Desc)])
  @@map("media")
}

// A PDF attached to a post. Deleting the post deletes these rows (Cascade):
// they are part of the post. The file itself is kept (Restrict on media) and
// can be removed separately once nothing uses it.
model PostAttachment {
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  title    String // what the reader sees: "Edital completo", not "scan_0034.pdf"
  position Int

  @@id([postId, mediaId])
  @@index([mediaId])
  @@map("post_attachments")
}

// ---------------------------------------------------------------------------
// Session — connect-pg-simple's table
//
// Declared here only so Prisma knows it exists. You will NEVER call
// `prisma.session` in application code — express-session owns this table.
//
// Left out of the schema, `prisma migrate dev` would report drift and offer to
// reset the database, taking your development data with it.
//
// Configure the store with `createTableIfMissing: false`, since Prisma creates it.
// The table name must stay exactly "session".
// ---------------------------------------------------------------------------

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Readers' comments under a news story or a column. Plain text only.
model Comment {
  id String @id @default(uuid(7))

  // Deleting the post takes its comments with it.
  postId String @map("post_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Null once the account is deleted: the text stays, signed "Conta excluída".
  userId String? @map("user_id")
  user   User?   @relation("CommentAuthor", fields: [userId], references: [id], onDelete: SetNull)

  // One level of replies: a reply always hangs from a top-level comment
  // (the service attaches a reply to a reply to the same top-level comment).
  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  content String // plain text, never HTML

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at") // shown as "editado em…"
  // A comment with replies is not removed, only emptied, so the replies keep
  // their context. Without replies it is really deleted.
  deletedAt DateTime? @map("deleted_at")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@map("comments")
}
