# You usually do not need to copy this by hand:
#   npm run db:test:setup
# creates .env.test from your .env, pointing at "<database>_test".
#
# The database name MUST end in _test — the suite refuses to run otherwise,
# because it drops and rebuilds the schema on every run.
NODE_ENV=test
DATABASE_URL="postgresql://portal:CHANGE_ME@localhost:5433/portal100fronteiras_test?schema=public"
SESSION_SECRET=test_secret_that_is_long_enough_for_zod_32
SITE_URL=http://localhost:5173
