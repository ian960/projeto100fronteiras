# Where the backend API is running. Vite forwards every /api request there.
# Use the port printed by the backend: "API listening on http://localhost:XXXX".
# Only needed outside Docker: docker-compose.yml sets it to the api container.
VITE_API_PROXY_TARGET=http://localhost:3333

# Google Analytics 4 (G-XXXXXXX). Leave empty here so your own test visits
# are not counted; the real ID is set in Cloudflare (build variables).
VITE_GA_ID=
