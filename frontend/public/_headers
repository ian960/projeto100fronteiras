# Response headers for the files Cloudflare serves. Article pages built by
# the Worker get the same ones from worker/index.ts (keep both in sync).

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://res.cloudinary.com; media-src 'self' https://res.cloudinary.com; frame-src https://www.youtube-nocookie.com; connect-src 'self' https://api.cloudinary.com; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Vite puts a hash of the content in these file names, so they never change:
# a browser can keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
