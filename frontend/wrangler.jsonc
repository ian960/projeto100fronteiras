// The site on Cloudflare: the files Vite builds (dist/) plus the Worker in
// worker/index.ts. Deployed by Cloudflare on every push to master (Workers
// Builds), or by hand with `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projeto-sem-fronteiras",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Any address without a file (/painel/materias, /categoria/cidade...)
    // gets index.html, and React Router takes it from there.
    "not_found_handling": "single-page-application",
    // Only these reach the Worker. Everything else is a plain file, which
    // Cloudflare serves without counting it against the Worker's free quota.
    "run_worker_first": [
      "/api/*",
      "/noticia/*",
      "/coluna/*",
      "/categoria/*",
      "/autor/*",
      "/sitemap.xml",
      "/sitemap-news.xml",
      "/robots.txt"
    ]
  },

  "vars": {
    // The API's address on Render. If Render gave the service another name
    // (it adds a suffix when the name is taken), change it here and push.
    "API_ORIGIN": "https://portal-api-o5v4.onrender.com",
    // The site's public address, used in canonical links, sitemaps and
    // robots.txt. Empty: the address the page was opened at (today the
    // workers.dev one). When the domain is ready, put it here without the
    // final slash, e.g. "https://portal100fronteiras.com.br", and push.
    "SITE_URL": ""
  },
  // PROXY_SECRET is a secret, not a var: set it in the dashboard (Settings →
  // Variables and Secrets) with the same value as on Render.

  // Previews: each Pull Request gets its own test address on Cloudflare.
  // There is only one API (Render), so the previews use it too. Careful:
  // whatever you do on a preview changes the real data.
  "previews": {
    "vars": {
      "API_ORIGIN": "https://portal-api-o5v4.onrender.com",
      // Previews keep their own address, so links on them stay on them.
      "SITE_URL": ""
    }
  },

  // Keeps Render's free instance awake (it sleeps after 15 minutes without a
  // request). Delete this block on a paid Render plan.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
