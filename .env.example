# Copy to .env (next to docker-compose.yml) and fill in.
#
# Use only letters and digits in the password: docker-compose.yml puts it
# inside a database URL, where @ : / # would break it. backend/.env uses the
# same user, password, database and port when the API runs outside Docker.
POSTGRES_USER=portal
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=portal100fronteiras
POSTGRES_PORT=5433

# Ports on this machine. Change only if something else already uses them.
API_PORT=3333
WEB_PORT=5173
